{
    "name": "hoshimi-bot",
    "version": "1.0.0",
    "description": "A example bot to show how to use hoshimi",
    "main": "./src/index.ts",
    "type": "module",
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "keywords": [],
    "author": "Ganyu Studios",
    "license": "MIT",
    "lint-staged": {
        "*.{ts,json}": [
            "pnpm format"
        ]
    },
    "contributors": [
        {
            "url": "https://github.com/EvilG-MC",
            "name": "JustEvil (EvilG-MC)"
        }
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
