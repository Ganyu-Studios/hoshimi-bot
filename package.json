    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/node": "^25.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    }
