        "seyfert": "^5.1.1-dev-34481657717.0",
        "yunaforseyfert": "1.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@types/node": "^26.5.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2"
    }
}
