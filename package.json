        "yunaforseyfert": "1.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^26.6.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
