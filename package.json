        "yunaforseyfert": "1.2.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^26.2.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "tsx": "^4.23.11",
        "typescript": "^7.0.2"
    }
}
