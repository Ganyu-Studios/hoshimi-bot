        "yunaforseyfert": "1.2.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.11",
        "@types/node": "^26.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2"
    }
}
