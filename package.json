        "yunaforseyfert": "1.1.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@types/node": "^26.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.8",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
