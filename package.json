        "format": "biome format --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "hoshimi": "0.5.0",
        "meowdb": "^2.2.3",
        "redis": "^6.2.0",
        "seyfert": "5.0.1-dev-30507709234.0",
        "yunaforseyfert": "1.2.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@types/node": "^26.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
