        "format": "biome format --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "hoshimi": "0.3.10-dev-24875946063.0",
        "meowdb": "^2.2.3",
        "redis": "^5.12.1",
        "seyfert": "4.3.1-dev-26073359071.0",
        "yunaforseyfert": "1.1.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@types/node": "^25.9.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3"
    }
}
